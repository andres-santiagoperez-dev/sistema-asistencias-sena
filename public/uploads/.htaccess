# ==============================================================================
# PROTECCIÓN DE SOPORTES MÉDICOS Y ARCHIVOS DE SUBIDA
# ==============================================================================
# Denegar todo acceso HTTP directo a los archivos subidos.
# Solo los scripts autenticados de PHP pueden despachar estos documentos.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
