# ==============================================================================
# DEFENSA EN PROFUNDIDAD - CARPETA INTERNA APP
# ==============================================================================
# Denegar todo acceso web directo a controladores, modelos, vistas y configuración.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
